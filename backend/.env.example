# ===== 学校大模型 API（OpenAI 兼容网关）=====
# 开工第一天先跑 docs/../check_api.py 验证 6 项能力再填这里
API_BASE_URL=https://your-school-gateway.example.com/v1
API_KEY=sk-xxx
CHAT_MODEL=qwen-max
VISION_MODEL=qwen-vl-max
EMBEDDING_MODEL=bge-m3          # 若学校网关无 embedding，留空并使用本地模型
EMBEDDING_USE_LOCAL=true        # true = 用本地 sentence-transformers(bge-m3) 兜底
LLM_TIMEOUT=60

# ===== 知识库（M1）=====
KB_DATA_DIR=./data/uploads       # PDF 原始文件落盘目录
CHUNK_SIZE=700                   # 分块 token 数（按上下文窗口调整）
CHUNK_OVERLAP=70
RETRIEVAL_TOP_K=5

# ===== 沙箱（M3）=====
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SEC=10
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MAX_CONCURRENCY=3

# ===== 数据库（M5）=====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zhixue

# ===== 服务 ======
CORS_ORIGINS=["http://localhost:3000"]
